#!/bin/sh
# [PERF-95] 훅 비간섭 비용을 없앤다.
#
# 하네스를 쓰지 않는 프로젝트에서도 Write/Edit/Bash 마다 node 가 두 번(pre+post) 뜬다 —
# 내용·부작용·토큰은 0 이지만 기동비 ~107ms/호출은 그대로 남는다(594KB 번들 require 포함).
# 이 스크립트는 그 판정을 sh 한 번(~4ms)으로 내린다.
#
# **판정 기준이 코어와 글자 그대로 같아야 한다.** 코어의 루트는
# `process.env.CLAUDE_PROJECT_DIR ?? process.cwd()` 이고 부모 디렉토리를 거슬러 올라가지
# 않는다(cli.ts main). 그래서 여기 조건은 추정이 아니라 **같은 판정**이다 — 어긋나면
# 하네스가 걸린 프로젝트에서 훅이 조용히 안 뜨고, 그것이 이 제품 최악의 실패다.
#
# hooks.json 문자열에 `[ -d … ] &&` 를 박지 않고 셔뱅 스크립트로 둔 이유: 호스트가 훅
# 명령을 셸로 해석하는지에 방어 전체를 걸지 않기 위해서다. 실행 파일은 어느 쪽이든 뜬다.
#
# 출력 없이 exit 0 = 「판정 없음(허용)」 — 하네스 없는 프로젝트의 기존 동작과 같다.
[ -d "${CLAUDE_PROJECT_DIR:-.}/.harness" ] || exit 0
exec "$(dirname "$0")/harness" hook "$@"
