#!/usr/bin/env node
// core/dist is committed so a plugin clone works without a build step. If someone deleted dist,
// or took only the sources, the bundle may be missing — and even then the hook must not break the
// session, so the hook path stays silent: one line of guidance and exit 0 (the do-no-harm contract).
// Ordinary CLI calls do not hide failure (exit 1).
let cli;
try {
  cli = require('../core/dist/cli.js');
} catch (err) {
  // [OPS-02] **강제가 꺼진 것을 아무도 모르는 상태**를 없앤다.
  //
  // 번들이 없거나 깨지면(부분 클론·실패한 업데이트·받다 만 다운로드·`git clean -x`) 훅 경로는
  // 무해 계약대로 조용히 exit 0 한다 — 그건 옳다. 문제는 그 사실이 **어디에도 안 남는 것**이었다:
  // stderr 는 exit 0 이면 사용자에게 안 보이고, `hook-errors.log` 는 require 가 실패한 뒤라
  // 기록조차 되지 않았으며, 유일한 자가 진단인 `doctor` 는 `ok: true` 라고 답했다.
  // 사용자는 설계 트랙인 줄 알고 소스를 마음껏 쓴다.
  //
  // `doctor` 는 이미 이 로그의 건수를 issue 로 올린다(`doctor.ts` countHookErrors). 그러니
  // **한 줄만 남기면** 기존 배선이 그대로 받는다. dist 가 없어도 도는 순수 node 코드여야 하므로
  // 여기서 직접 쓴다. 실패는 무시한다 — 로그를 못 남기는 것이 세션을 깨는 이유가 될 수는 없다.
  try {
    const fs = require('fs');
    const path = require('path');
    const root = process.env.CLAUDE_PROJECT_DIR || process.cwd();
    if (fs.existsSync(path.join(root, '.harness'))) {
      const dir = path.join(root, '.harness', '.runtime');
      fs.mkdirSync(dir, { recursive: true });
      fs.appendFileSync(
        path.join(dir, 'hook-errors.log'),
        `${new Date().toISOString()} no-bundle enforcement-off `
        + `argv=${JSON.stringify(process.argv.slice(2))} ${String((err && err.message) || err)}\n`,
      );
    }
  } catch { /* 무해 계약: 기록 실패가 세션을 깨지 않는다 */ }
  console.error('king-wjang-harness: no build in core/dist — run `npm install` (prepare) or `npm run prepare` to build it.');
  process.exit(process.argv[2] === 'hook' ? 0 : 1);
}
cli.main(process.argv.slice(2));
